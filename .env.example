# ================================================================
# AI Commercial Agent - Variables de Entorno (.env)
# ================================================================
# 
# Este archivo documenta todas las variables de entorno disponibles.
# Cópialo a .env y rellena los valores según tu entorno.
#
# IMPORTANTE: Nunca commits .env a git (solo .env.example)
# ================================================================

# ================================================================
# 1. CONFIGURACIÓN DE PROVEEDORES LLM
# ================================================================

# Token API de HuggingFace
# Obtenlo en: https://huggingface.co/settings/tokens
# Si NO se proporciona, solo estará disponible MockLLM
# REQUERIDO si quieres usar HuggingFace como provider
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxx

# Orden de proveedores LLM a probar (separados por coma)
# Opciones disponibles: hf (HuggingFace), mock (MockLLM)
# El sistema intenta en orden y hace fallback automático
# DEFAULT: "hf,mock"
# OPCIONAL
LLM_ORDER=hf,mock

# Número máximo de reintentos por provider LLM
# Si un provider falla, reintenta este número de veces
# DEFAULT: "2"
# OPCIONAL
LLM_MAX_RETRIES=2

# ================================================================
# 2. CONFIGURACIÓN DE CORS (Cross-Origin Resource Sharing)
# ================================================================

# Orígenes permitidos para acepta requests CORS
# Separados por coma, sin espacios al final
# Ejemplos:
#   - Desarrollo local: http://localhost:3000,http://localhost:8000
#   - Producción: https://app.ejemplo.com,https://www.ejemplo.com
# DEFAULT: "http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"
# OPCIONAL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ================================================================
# 3. CONFIGURACIÓN DE PERSISTENCIA DE SESIONES
# ================================================================

# Backend de almacenamiento de sesiones (conversational memory)
# Opciones:
# - "memory": En memoria (rápido, para desarrollo, se pierden datos al reiniciar)
# - "filesystem": Archivos JSON (persistencia local, debugging fácil, no escalable)
# - "redis": Redis (futuro, para producción escalable)
#
# DEFAULT: "memory"
# OPCIONAL
SESSION_STORE=memory

# ================================================================
# 3. CONFIGURACIÓN DE BASE DE DATOS / PERSISTENCIA (FUTURA)
# ================================================================
#
# Placeholder para futuras implementaciones de:
# - Persistencia de SessionManager (Redis/DB)
# - Vector store remoto
# - Caché de embeddings
#

# ================================================================
# 4. CONFIGURACIÓN DE LOGGING (OPCIONAL)
# ================================================================
#
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEFAULT: INFO
# LOG_LEVEL=INFO
#

# ================================================================
# VALORES DE EJEMPLO Para Desarrollo Local
# ================================================================
# 
# HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxx
# LLM_ORDER=mock,hf
# LLM_MAX_RETRIES=3
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
#

# ================================================================
# NOTAS IMPORTANTES
# ================================================================
#
# 1. Si HF_API_TOKEN no está configurado:
#    - El endpoint /chat funcionará con MockLLM
#    - Las respuestas serán simuladas (no reales)
#
# 2. MockLLM es útil para:
#    - Testing sin costos API
#    - Desarrollo local
#    - Demostración de arquitectura
#
# 3. Para producción:
#    - Asegúrate de que HF_API_TOKEN esté correctamente configurado
#    - Usa LLM_ORDER="hf,mock" para fallback a mock si HF falla
#    - Configura CORS_ALLOWED_ORIGINS con tus dominios reales
#
# 4. Variables no documentadas aquí serán ignoradas
#
